# ============================================================
# CONFIGURACIÓN DE ENTORNO PARA PRODUCCIÓN - AEGOPS
# ============================================================
# ⚠️ ARCHIVO DE PLANTILLA PARA PRODUCCIÓN ⚠️
# Este archivo debe renombrarse a .env y configurarse con valores reales
# NO incluir este archivo en repositorios públicos
# ============================================================

# AEGOPS — Base de datos (Configurar con valores del hosting)
DB_HOST=your_database_host
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_secure_password
DB_PORT=3306

# AEGOPS — Correo (remitente)
MAIL_FROM=webmaster@aegops.com
MAIL_TO=info@aegops.com

# Sesión (en segundos)
SESSION_LIFETIME=7200

# Entorno de ejecución
APP_ENV=production

# Token de administrador (Configurar como variable de entorno del servidor)
# ⚠️ NO incluir el token real aquí. Configurarlo en el panel del hosting:
# export ADMIN_TOKEN=tu_token_seguro_generado
# ADMIN_TOKEN=